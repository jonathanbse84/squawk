{
  "name": "squawk",
  "version": "1.0.0",
  "private": true,
  "description": "Squawk — jeu de contrôle aérien (tour de contrôle)",
  "scripts": {
    "copy": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','config.js'])if(fs.existsSync(f))fs.copyFileSync(f,'www/'+f);console.log('www/ prêt');\"",
    "sync": "npm run copy && cap sync",
    "add:ios": "cap add ios",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
